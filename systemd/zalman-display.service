[Unit]
Description=Zalman Alpha 2 display
After=graphical-session.target

[Service]
Type=simple
# From source:
#   WorkingDirectory=/path/to/zalman-display
#   ExecStart=/usr/bin/python3 -m zalman_lcd run --quiet
# When installed with pip (provides the zalman-display command):
ExecStart=%h/.local/bin/zalman-display run --quiet
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
